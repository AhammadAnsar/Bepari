# Bepari — Environment Configuration Template (Names Only — Never Commit Secrets)

# Runtime & Server
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info
TRUSTED_PROXY_HOPS=1

# Cloud SQL for PostgreSQL (AI Studio / Cloud Run Auth Proxy Socket or Host)
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=

# Cloud SQL Admin Credentials (Used by Drizzle Kit for schema migrations only)
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# External Managed PostgreSQL Fallback (Only used when SQL_HOST is not provided)
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=prefer

# Authentication & Session Security (Server-side HMAC/Session Secret)
SESSION_SECRET=

# Optional Storage & Integrations (Phase-gated)
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
EMAIL_PROVIDER_API_KEY=
GEMINI_API_KEY=
APP_URL=
